# Postgres connection string (Render: the shared database's External/Internal URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/portfolio
# Postgres schema that holds this app's tables
DB_SCHEMA=resume_shortlister
# Allowed CORS origins, comma-separated
FRONTEND_URL=http://localhost:5200
# Groq API key for AI fit summaries (optional; summaries are skipped without it)
GROQ_API_KEY=your-groq-api-key
# semantic (MiniLM ONNX, default) or tfidf
MATCH_METHOD=semantic
# Where NLTK corpora live
NLTK_DATA=./nltk_data
